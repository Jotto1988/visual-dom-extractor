{
  "manifest_version": 3,
  "name": "Visual DOM Extractor",
  "version": "1.0.0",
  "description": "Click-to-select DOM-to-JSON extractor with clean exports.",
  "action": {
    "default_title": "Toggle Extractor"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
